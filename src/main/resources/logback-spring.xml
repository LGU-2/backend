<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================
         로컬/개발: 사람이 읽기 좋은 콘솔 포맷 + MDC(traceId 등) 노출

         이 프로젝트는 아직 spring.profiles.active/default 를 정해두지 않았다("prod" 프로필도
         아직 별도 application-prod.yml 이 없다). 그래서 "local" 대신 "!prod"(prod가 아니면)로
         걸어서, 프로필을 아무것도 안 켠 기본 실행에서도 로그가 비지 않게 한다. prod 프로필이
         실제로 도입되는 시점엔 이 조건을 그대로 둬도 되고, 로컬 전용 설정이 더 필요해지면 그때
         "local"로 좁혀도 된다.
         ================================================================ -->
    <springProfile name="!prod">
        <!-- %line(파일명:라인번호)은 caller data가 필요해서 성능 비용이 있다 — 로컬은 트래픽이
             적고 동기 로깅이라 부담이 작고, IntelliJ 콘솔은 "ClassName.java:42" 패턴을 인식해서
             클릭하면 바로 그 줄로 이동하는 링크로 만들어주기 때문에 로컬에서만 켠다. prod는
             AsyncAppender의 includeCallerData=false와 일관되게 caller data를 아예 안 켠다
             (비동기 로깅에서 caller data 계산 비용이 더 커지기 때문 — 아래 prod 프로필 참고).

             주의: %logger{36} 바로 뒤에 괄호로 시작하는 리터럴("(%F:%line)")을 붙이면 Logback의
             PatternParser가 그 여는 괄호를 또 다른 컴포지트 컨버터(%word(...) 형태)의 시작으로
             오인해서 그 뒤 " - %msg%n"까지 파싱에 실패해 통째로 사라진다 — 그래서 괄호 없이
             %F:%line으로 쓴다. 또한 %X{traceId:-} 같은 ":-" 기본값 문법은 Log4j2 전용이라
             Logback의 %X는 지원하지 않으므로(값이 없으면 그냥 빈 문자열) 콜론 없이 %X{traceId}로
             쓴다. -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
                    %d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId}] %X{method} %X{uri} %X{clientIp} %cyan(%logger{36}) %F:%line - %msg%n
                </pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ================================================================
         프로덕션: JSON 구조화 로그 (ELK / Loki / CloudWatch 수집용)
         의존성: net.logstash.logback:logstash-logback-encoder:8.0
         - MDC 필드(traceId, method, uri, clientIp)가 JSON 키로 자동 포함
         - AsyncAppender 로 로깅 I/O 가 요청 스레드를 블로킹하지 않게 함
         ================================================================ -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>method</includeMdcKeyName>
                <includeMdcKeyName>uri</includeMdcKeyName>
                <includeMdcKeyName>clientIp</includeMdcKeyName>
                <!-- 스택트레이스 폭주 방지: 프레임/길이 제한 + 패키지 축약 -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>8192</maxLength>
                    <shortenedClassNameLength>36</shortenedClassNameLength>
                    <rootCauseFirst>true</rootCauseFirst>
                    <exclude>^jdk\.internal\..*</exclude>
                    <exclude>^java\.lang\.reflect\..*</exclude>
                    <exclude>^org\.springframework\.web\.filter\..*</exclude>
                    <exclude>^jakarta\.servlet\..*</exclude>
                </throwableConverter>
                <customFields>{"service":"freshmarket"}</customFields>
            </encoder>
        </appender>

        <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="JSON_CONSOLE"/>
            <queueSize>1024</queueSize>
            <!-- 큐 포화 시에도 WARN/ERROR 는 절대 버리지 않음 -->
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>false</neverBlock>
            <includeCallerData>false</includeCallerData>
        </appender>

        <root level="INFO">
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>

</configuration>
