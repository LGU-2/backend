# 이 파일을 .env 로 복사해서 필요한 줄만 고친다. .env 는 추적하지 않는다.
#
#   cp .env.example .env
#
# 아무것도 안 고쳐도 된다. 값을 비워 두면 아래 기본값으로 동작한다.
# 고칠 일이 생기는 것은 대개 포트가 이미 쓰이고 있을 때다.

# compose 가 띄우는 MySQL 의 호스트 포트. 3306 이 이미 쓰이면 여기만 바꾼다
MYSQL_PORT=3306

# 컨테이너 이름. 다른 프로젝트와 겹칠 때만 바꾼다
MYSQL_CONTAINER_NAME=freshmarket-mysql

MYSQL_DATABASE=freshmarket
MYSQL_USER=freshmarket
MYSQL_PASSWORD=freshmarket
MYSQL_ROOT_PASSWORD=root

# 아래 셋은 compose 를 쓰지 않고 붙을 때만 쓴다.
# bootRun 은 compose 가 띄운 컨테이너에서 접속 정보를 직접 읽으므로 필요 없다.
# 셸 환경변수로 줘야 하며 이 파일은 Spring 이 읽지 않는다 (compose 만 읽는다)
#
# DB_URL=jdbc:mysql://localhost:3306/freshmarket?serverTimezone=UTC&characterEncoding=UTF-8
# DB_USERNAME=freshmarket
# DB_PASSWORD=freshmarket

# compose 가 띄우는 Redis 의 호스트/포트. 6379 가 이미 쓰이면 여기만 바꾼다
REDIS_PORT=6379

# 회원 로그인(카카오 OIDC). 카카오 개발자 콘솔의 내 애플리케이션 > 앱 키 / 카카오 로그인에서 확인한다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔에 등록한 Redirect URI 와 정확히 같아야 한다. 프론트가 콜백을 받는 주소다
# (docs/api/auth.md: 카카오가 이 주소로 code 를 붙여 302 리다이렉트하면 프론트가 받아서 백엔드로 넘긴다)
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/callback
# 연결 해제 웹훅 검증, 로그아웃 시 카카오 로그아웃 API 호출에 쓰는 어드민 키
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=

# 회원 JWT 서명 키. 운영에서는 반드시 충분히 긴 랜덤 값으로 바꾼다
JWT_SECRET=
# 기본값: access 30분(1800000ms), refresh 14일(1209600000ms) — docs/api/auth.md 기준
# JWT_ACCESS_VALIDITY_MS=1800000
# JWT_REFRESH_VALIDITY_MS=1209600000
# 로컬은 http 라 꺼둔다. 운영(https)에서는 반드시 true 로
# JWT_COOKIE_SECURE=true

# 프론트 배포 주소. CORS 허용 오리진으로 쓰인다(쉼표로 여러 개 가능)
# CORS_ALLOWED_ORIGINS=http://localhost:5173
